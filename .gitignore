/temp/
/server/__pycache__/

# Generated Windows-side tooling, not Flutter source
/windows/flutter/bin/
/windows/flutter/micromamba/
/windows/flutter/temp/
/windows/flutter/*.vsix
/windows/flutter/rcc.yaml
/windows/flutter/rcccache.yaml
